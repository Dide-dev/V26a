# These environment variables are not used by the backend, but by postgres in the docker-compose.yml
POSTGRES_DB=postgres_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Where to serve the application, the reverse proxy must be able to listen on this host / port.
# You can specify a port like ":8000" to serve there instead.
BASE_URL=http://localhost

# See the docs of tracing_subscriber for the exact syntax that is allowed to be used:
# https://docs.rs/tracing-subscriber/0.3.23/tracing_subscriber/filter/struct.EnvFilter.html#example-syntax
RUST_LOG=INFO

# In production this MUST change to a secure randomly generated string.
JWT_SECRET=secret
# This amount of seconds corresponds to 1 week.
SESSION_EXPIRATION_SECONDS=604800

# Relative to project root directory.
UPLOAD_DIR=./uploads
# Unit is Mebibytes.
MAX_UPLOAD_SIZE_MB=10

# Mailing settings
SMTP_SERVER=smtp.example.com
SMTP_USERNAME=username
SMTP_PASSWORD=password
SMTP_URL="smtps://${SMTP_USERNAME}:${SMTP_PASSWORD}@${SMTP_SERVER}"

# Following variables are only used when running the backend locally.

# Postgresql is the only supported database.
DB_HOST=localhost
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}/${POSTGRES_DB}"

# Can also be an hostname instead of an IP address like 'localhost'
LISTENING_IP="127.0.0.1" # Can be omitted, defaults to "0.0.0.0"
LISTENING_PORT="3000" # Can be omitted, defaults to "3000
