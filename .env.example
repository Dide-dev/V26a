# These environment variables are not used by the backend, but by postgres in the docker-compose.yml
POSTGRES_DB=postgres_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Where to serve the application, the reverse proxy must be able to listen on this host / port.
# You can specify a port like ":8000" to serve there instead.
BASE_URL=http://localhost

# See the docs of tracing_subscriber for the exact syntax that is allowed to be used:
# https://docs.rs/tracing-subscriber/0.3.23/tracing_subscriber/filter/struct.EnvFilter.html#example-syntax
RUST_LOG=INFO

# In production this MUST change to a secure randomly generated string.
JWT_SECRET=secret
# This amount of seconds corresponds to 1 week.
SESSION_EXPIRATION_SECONDS=604800

# Relative to project root directory.
UPLOAD_DIR=./uploads
# Unit is Mebibytes.
MAX_UPLOAD_SIZE_MB=10

# The limiter works like a token bucket. So the burst is the max tokens and the limit itself is the refill rate. 
# It limits the amount of request an user can send and a limiter grants an ip-adress 1 bucket (2 limiters are used).
# Per-second rate limit (maximum number of requests per second). This protects against (fast) spikes.
RATE_LIMIT_PER_SECOND=5
# Check for bursts for the per-second limiter (maximum burst).
RATE_LIMIT_BURST_SIZE_SECOND=10
# Strict per second rate limiter. Strict limiters are used for specific endpoints that needs more limiting.
RATE_LIMIT_PER_SECOND_STRICT=3 
# Strict burst size for per-second limiter.
RATE_LIMIT_BURST_SIZE_SECOND_STRICT=1 
# Per-minute rate limit, hard limit regardless of per-second bursts (maximum number of requests per minute). This protects against long sustained spikes.  
RATE_LIMIT_PER_MINUTE=60
# Check for bursts for the per-second limiter (maximum burst). Lower than the per minute, because that limiter is an hard cap. 
RATE_LIMIT_BURST_SIZE_MINUTE=20
# Strict per minute limiter.
RATE_LIMIT_PER_MINUTE_STRICT=30
# Strict burst size for per-minute limiter.
RATE_LIMIT_BURST_SIZE_MINUTE_STRICT=10

# Following variables are only used when running the backend locally.

# Postgresql is the only supported database.
DB_HOST=localhost
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}/${POSTGRES_DB}"

# Can also be an hostname instead of an IP address like 'localhost'
LISTENING_IP="127.0.0.1" # Can be omitted, defaults to "0.0.0.0"
LISTENING_PORT="3000" # Can be omitted, defaults to "3000
