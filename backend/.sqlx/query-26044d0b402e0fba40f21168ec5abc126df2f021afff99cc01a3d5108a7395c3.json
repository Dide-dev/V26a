  "query": "SELECT trees.*, books.title AS book_name, books.author AS book_author, books.edition AS book_edition, ARRAY(SELECT tag FROM tags WHERE tree_id = trees.id) AS tags\n        FROM trees \n        LEFT JOIN books ON trees.book_isbn = books.isbn \n        WHERE owner_id = $1",
